# Copy to .env beside fleet.yaml, then `docker compose up -d --build`.
#
# One key for the whole fleet: the SPINLOOP_API_TOKEN of every node's daemon,
# and the key studio's engine is gated with. Compose passes it into the
# containers, and fleet.yaml references the same variable by name, so the
# client authenticates with it and sends it when it starts a gated engine.
# Any non-empty value works — this is an example token for a local stack, not
# a secret.
FLEET_TOKEN=fleet-dev-token
