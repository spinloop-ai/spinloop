# Copy to .env beside fleet.yaml, then `docker compose up -d --build`.
#
# Every value is a bearer secret for one box: the NODE_*_TOKENs gate each
# node's daemon control API, the NODE_*_ENGINE_KEYs gate each engine, and
# GATEWAY_TOKEN gates the gateway (both gateway services share it). Any
# non-empty values work — these are example secrets for a local stack, not
# secrets to reuse anywhere real.
NODE_A_TOKEN=node-a-dev-token
NODE_B_TOKEN=node-b-dev-token
NODE_A_ENGINE_KEY=node-a-engine-dev-key
NODE_B_ENGINE_KEY=node-b-engine-dev-key
GATEWAY_TOKEN=gateway-dev-token
